# Skopiuj do .env i uzupelnij

# Widoczny Chrome + slowMo do testow lokalnych (na serwerze NIE ustawiac)
DEBUG=true

# Dane logowania do konta bilety.mhk.pl
LOGIN=
PASSWORD=

# Magazyn stanu (Deno KV) — plik SQLite, tworzony sam razem z katalogiem.
#  - lokalnie: domyslnie ./.data/kv.sqlite (gitignorowane) — nie ustawiaj
#  - Railway:  KV_PATH=/data/kv.sqlite  + podepnij Volume pod /data
# KV_PATH=

# Panel web (worker serwuje go na $PORT, lokalnie 8080).
#  http://localhost:8080/  -> zakladka "dump" (stan KV) + "inne" (pusta)
#  UI_TOKEN ustawione -> wymagane ?token=... (chron, jesli domena publiczna)
# UI_TOKEN=

# Powiadomienia o bledach przez Telegram (opcjonalne; bez tego tylko stderr).
#  1. @BotFather -> /newbot -> skopiuj token
#  2. napisz cokolwiek do swojego bota, potem otworz
#     https://api.telegram.org/bot<TOKEN>/getUpdates i odczytaj "chat":{"id":...}
#     (albo napisz do @userinfobot)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Polityka rezerwacji (rolling horizon) — domyslne w src/config.ts ---
# LEAD_DAYS=2                # od dzis + tyle dni (poczatek okna)
# HORIZON_DAYS=21           # do dzis + tyle dni (koniec okna; zaczynaj maly)
# WEEKDAYS=0,1,2,3,4,5,6    # 0=niedziela .. 6=sobota
# SKIP_DATES=2026-12-25,2026-12-26   # dni zamkniecia / swieta
# SLOTS_PER_DAY=1           # ile osobnych rezerwacji na dobe (rozne godziny)
# PREFERRED_TIMES=12:00,13:00   # probuj te godziny w tej kolejnosci PRZED zakresem
# TIME_FROM=10:00           # dolna granica okna godzinowego (fallback)
# TIME_TO=14:00             # gorna granica
# QUANTITY=15               # biletow na jedna rezerwacje
# WITH_GUIDE=true

# --- TYLKO DO TESTOW ---
# Po kazdym przebiegu workera wysyla pelny zrzut bazy na Telegram
# (wymaga TELEGRAM_TOKEN + TELEGRAM_CHAT_ID). Wylaczenie: usun te linie
# albo ustaw na cokolwiek innego niz "true".
# DEBUG_DUMP_NOTIFY=true

# --- Strojenie (opcjonalne, wartosci w ms) ---
# HOLD_MS=18000000          # deklarowany czas zycia rezerwacji (5 h)
# RECREATE_GRACE_MS=60000   # odczekaj tyle PO wygasnieciu przed odtworzeniem
# MIN_SLEEP_MS=60000        # dolny prog dynamicznego snu workera
# MAX_SLEEP_MS=900000       # gorny prog (worker budzi sie na najblizsze wygasniecie)
# MAX_ATTEMPTS=5
# CREATE_BUDGET=5           # ile rezerwacji odtwarzac/tworzyc na przebieg
# LOST_RETRY_MS=300000            # nasze miejsce stracone w luce — ponow po 5 min
# UNAVAILABLE_RETRY_MS=43200000   # nowy dzien bez miejsc — ponow po 12 h
# FAILED_RETRY_MS=3600000         # blad techniczny — ponow po 1 h
# MIDNIGHT_WINDOW_MS=300000       # tyle po polnocy: nowe daty pierwsze, od najpozniejszej
